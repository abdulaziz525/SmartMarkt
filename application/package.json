{
  "name": "smartmarkt",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" -n \"backend,frontend\" \"npm run dev:backend --silent\" \"npm run dev:frontend --silent\"",
    "dev:backend": "npm run dev --workspace=backend --silent",
    "dev:frontend": "npm run dev --workspace=frontend --silent",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:frontend && npm run build:backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
