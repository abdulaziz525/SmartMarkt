# Database Type: postgres or mysql
DB_TYPE=postgres

# Database Connection Details
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=smartmarkt

# Server Configuration
PORT=3001

# Comma-separated whitelist of allowed frontend origins for CORS in production
# (e.g. https://smartmarkt.com,https://www.smartmarkt.com). Unset in dev to allow any origin.
# CORS_ORIGIN=

# JWT secret (required in production)
# JWT_SECRET=

# Access/refresh token lifetimes, in seconds (defaults: 15 min / 7 days)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800

# Redis connection for the logged-out token blacklist, shared across backend
# instances in production. Falls back to an in-memory blacklist when unset.
# REDIS_URL=redis://localhost:6379

# SMTP Configuration for Email Verification
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="SmartMarkt" <noreply@smartmarkt.com>
